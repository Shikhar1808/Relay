# The store worker (app/worker.py): the backend's code plus helm, kubectl and the store
# chart it installs. The API image stays without any cluster tool. Built from the repo
# root, because it copies helm/store and woo-mcp's init script:
#
#   docker build -f backend/Dockerfile.worker -t relay-store-worker:0.1.0 .
#
# What it may copy is listed in Dockerfile.worker.dockerignore.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.16 /uv /uvx /bin/

# shortcut: amd64 binaries only; add the arm64 ones and their checksums for an ARM server.
# kubectl matches the cluster's minor version (k3s v1.35).
ADD --checksum=sha256:70b2c30a19da4db264dfd68c8a3664e05093a361cefd89572ffb36f8abfa3d09 \
    https://get.helm.sh/helm-v4.1.4-linux-amd64.tar.gz /tmp/helm.tar.gz
ADD --checksum=sha256:90f75ea6ecc9ea5633262e1c0b83a40560003b30fc94a04cb099404fcef0c224 \
    https://dl.k8s.io/release/v1.35.5/bin/linux/amd64/kubectl /usr/local/bin/kubectl
RUN tar -xzf /tmp/helm.tar.gz -C /usr/local/bin --strip-components=1 linux-amd64/helm \
    && rm /tmp/helm.tar.gz && chmod 755 /usr/local/bin/kubectl

WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev
COPY backend/app ./app
COPY helm/store /charts/store
COPY woo-mcp/deploy/wp-init.sh /charts/wp-init.sh

# helm and kubectl keep caches under HOME; /tmp is the one writable place in the pod.
ENV PATH="/app/.venv/bin:$PATH" HOME=/tmp
CMD ["python", "-m", "app.worker"]
