POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me

JWT_SECRET=change-me-to-a-long-random-string

# Encrypts upstream MCP server credentials (AES-256-GCM). 32 random bytes, base64:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing or changing it makes every stored credential unreadable.
GATEWAY_ENCRYPTION_KEY=
# Shared secret between the gateway and the backend's /internal routes (32+ characters):
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
INTERNAL_SERVICE_TOKEN=
# Password of the gateway's read-only database role (letters and digits only,
# because it is placed in a connection URL).
GATEWAY_DB_PASSWORD=
# Signs the gateway's audit log so tampering shows (32+ characters). Only the gateway holds it:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# Changing it makes every earlier audit row fail verification.
AUDIT_HMAC_KEY=
# How much of each tool call the audit log keeps: minimal, standard or full (see gateway/README.md).
AUDIT_DETAIL=standard
# The gateway's address as MCP clients reach it.
GATEWAY_PUBLIC_URL=http://localhost:8080

# Optional: set both to auto-create the admin on startup. Leave both blank to
# create the admin via POST /auth/admin/signup instead (works once, then
# always 409s — see backend/IMPLEMENTATION.md). Must be 8-20 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-8to20

# Email (invites, password resets, account notices). SMTP_PASSWORD is your
# Resend API key (re_...). Leave it blank and emails are printed to the
# backend log instead of sent. Host/port/user default to Resend's SMTP relay.
SMTP_PASSWORD=
# The default sender only delivers to your own Resend account's address.
# To mail anyone else, verify a domain in Resend and use an address on it.
SMTP_FROM=Urumi <onboarding@resend.dev>
# Where people open the frontend. It is the base of the links inside emails, and the
# only address whose pages may call the API with a signed-in session (set CORS_ORIGINS,
# a JSON list, to allow others; "*" is refused).
APP_BASE_URL=http://localhost:3000
# The backend's address as a BROWSER reaches it (the frontend calls it directly).
API_URL=http://localhost:8000

# ---- The chat agent's model ----
# A Groq API key (gsk_..., free at https://console.groq.com/keys). Leave it blank and the
# chat answers that it is not set up; nothing else depends on it.
GROQ_API_KEY=
# The model, and where it is reached (any address that speaks the OpenAI chat format).
# The model must support tool calling.
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# ---- The first store (WordPress + WooCommerce) and its MCP server ----
# Passwords of the store's own MySQL: the WordPress user's, and root's.
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Sign-in for the store's wp-admin (http://localhost:8081/wp-admin), user "admin".
# Every start sets the store's password to this one: change it here, not in wp-admin.
WP_ADMIN_PASSWORD=
# The store's REST API key pair. The init script registers these two in WooCommerce and the
# MCP server signs in with them. Exactly this shape (the prefix, then 40 hex characters):
#   python -c "import secrets;print('ck_'+secrets.token_hex(20))"
#   python -c "import secrets;print('cs_'+secrets.token_hex(20))"
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=
# What the gateway presents to the WooCommerce MCP server (32+ characters):
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
WOO_MCP_TOKEN=
# The first store's subdomain: lowercase letters, digits and hyphens, at most 30 characters.
# Its tools are named woo-<subdomain>__<tool>. No domain is configured locally: the
# storefront is at FIRST_STORE_URL.
FIRST_STORE_SUBDOMAIN=demo
FIRST_STORE_NAME=Demo Store
FIRST_STORE_URL=http://localhost:8081
# The store's time zone: "today's orders" means its day. Used when the store is first set up.
WP_TIMEZONE=Asia/Kolkata

# ---- Servers 2 and 3: risk check and fulfilment (registered by hand, see their READMEs) ----
# What the gateway presents to each of the two servers (32+ characters):
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
RISK_MCP_TOKEN=
FULFILMENT_MCP_TOKEN=
# Password of fulfilment-mcp's own database role (hex only, because it is placed in a connection URL):
#   python -c "import secrets;print(secrets.token_hex(24))"
FULFILMENT_DB_PASSWORD=
